From 45ef1089416db7f6b7001cf1116db4ce69456f99 Mon Sep 17 00:00:00 2001
From: Teng Mei <73174080+meitmt@users.noreply.github.com>
Date: Fri, 16 Oct 2026 14:15:50 +0900
Subject: [PATCH] ggml : skip copying split inputs that only unselected select
 branches read

Since #29622, build_inp_embd adds a mixed-batch branch to the input
embeddings select for every architecture that supports mixed batches.
For a text-only batch that branch is not selected and its nodes are not
computed, but its inputs (inp_mixed_embd, inp_mixed_slots) were still
copied to the device every graph evaluation, each with a synchronization.

Record, per split input, whether any computed node reads it, and skip
the copy otherwise. The inputs stay in the split so allocation and graph
topology are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-backend.cpp | 42 +++++++++++++++++++++++++++++++++++----
 1 file changed, 38 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index ffbcba366..f60c32724 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -917,6 +917,7 @@ struct ggml_backend_sched_split {
     int i_start;
     int i_end;
     struct ggml_tensor ** inputs;
+    bool * inputs_used; // [inputs_capacity] true if a computed node reads the input, otherwise its copy can be skipped
     int n_inputs;
     int inputs_capacity;
     // graph view of this split
@@ -1005,6 +1006,12 @@ static void ggml_backend_sched_split_inputs_grow(struct ggml_backend_sched_split
         GGML_ABORT("failed to grow split inputs container");
     }
     split->inputs = pnew;
+    auto * pused = (bool *) realloc((void *) split->inputs_used, new_cap * sizeof(bool));
+    if (pused == NULL) {
+        GGML_LOG_ERROR("%s: failed to allocate %zu bytes\n", __func__, new_cap * sizeof(bool));
+        GGML_ABORT("failed to grow split inputs container");
+    }
+    split->inputs_used = pused;
     split->inputs_capacity = new_cap;
 }
 
@@ -1521,8 +1528,27 @@ void ggml_backend_sched_split_graph(ggml_backend_sched_t sched, struct ggml_cgra
                 GGML_ASSERT(src_backend_id != -1); // all inputs should be assigned by now
 
                 if (src_backend_id != cur_backend_id && !ggml_backend_sched_buffer_supported(sched, src, cur_backend_id)) {
+                    // nodes of unselected ggml_build_forward_select branches are not computed, so the inputs that only
+                    // they read do not need to be copied (e.g. the raw embeddings input of a text-only batch)
+                    const bool computed = (node->flags & GGML_TENSOR_FLAG_COMPUTE) != 0;
+
                     // create a copy of the input in the split's backend
-                    if (tensor_id_copy(src_id, cur_backend_id, 0) == NULL) {
+                    if (tensor_id_copy(src_id, cur_backend_id, 0) != NULL) {
+                        // the copy is owned by an earlier split on this backend: mark it as used there
+                        for (int s = i_split; computed && s >= 0; s--) {
+                            struct ggml_backend_sched_split * prev = &sched->splits[s];
+                            if (prev->backend_id != cur_backend_id) {
+                                continue;
+                            }
+                            for (int k = 0; k < prev->n_inputs; k++) {
+                                if (prev->inputs[k] == src) {
+                                    prev->inputs_used[k] = true;
+                                    s = -1;
+                                    break;
+                                }
+                            }
+                        }
+                    } else {
                         ggml_backend_t backend = sched->backends[cur_backend_id];
                         for (int c = 0; c < sched->n_copies; c++) {
                             struct ggml_tensor * tensor_copy = ggml_dup_tensor_layout(sched->ctx, src);
@@ -1539,6 +1565,7 @@ void ggml_backend_sched_split_graph(ggml_backend_sched_t sched, struct ggml_cgra
                             ggml_backend_sched_split_inputs_grow(split);
                         }
                         split->inputs[n_inputs] = src;
+                        split->inputs_used[n_inputs] = computed;
                     }
                     node->src[j] = tensor_id_copy(src_id, cur_backend_id, sched->cur_copy);
                 }
@@ -1873,9 +1900,15 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         int split_backend_id = split->backend_id;
         ggml_backend_t split_backend = sched->backends[split_backend_id];
 
+        int n_inputs_used = 0;
+        for (int input_id = 0; input_id < split->n_inputs; input_id++) {
+            n_inputs_used += split->inputs_used[input_id];
+        }
+
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
-        if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id) {
+        // (copying an input synchronizes too, so this is only needed when no input is copied)
+        if (n_inputs_used == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id) {
             if (sched->events[prev_backend_id][sched->cur_copy] != NULL) {
                 ggml_backend_event_synchronize(sched->events[prev_backend_id][sched->cur_copy]);
             } else {
@@ -1886,12 +1919,12 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         // copy the input tensors to the split backend
         // the weights in host memory are copied last, so that the copy callback can read the other inputs of the split
         for (int input_id = 0; input_id < split->n_inputs; input_id++) {
-            if (!ggml_backend_sched_is_host_weight(split->inputs[input_id])) {
+            if (split->inputs_used[input_id] && !ggml_backend_sched_is_host_weight(split->inputs[input_id])) {
                 ggml_backend_sched_copy_input(sched, split, split->inputs[input_id]);
             }
         }
         for (int input_id = 0; input_id < split->n_inputs; input_id++) {
-            if (ggml_backend_sched_is_host_weight(split->inputs[input_id])) {
+            if (split->inputs_used[input_id] && ggml_backend_sched_is_host_weight(split->inputs[input_id])) {
                 ggml_backend_sched_copy_input(sched, split, split->inputs[input_id]);
             }
         }
@@ -2032,6 +2065,7 @@ void ggml_backend_sched_free(ggml_backend_sched_t sched) {
     ggml_hash_set_free(&sched->hash_set);
     for (int i = 0; i < sched->splits_capacity; i++) {
         free(sched->splits[i].inputs);
+        free(sched->splits[i].inputs_used);
     }
     free(sched->splits);
     free(sched->graph_inputs);
-- 
