+// a single column with short rows leaves most MMVQ threads idle, the MMQ tiles are faster there
+static bool ggml_cuda_should_use_mmq_short_k(const ggml_tensor * src0, int64_t ne11, int cc) {
+    if (ne11 != 1 || src0->ne[0] > 256 || !GGML_CUDA_CC_IS_NVIDIA(cc) || !turing_mma_available(cc)) {
+        return false;
+    }
+    switch (src0->type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+            return ggml_cuda_should_use_mmq(src0->type, cc, ne11, /*n_experts =*/ 0);
+        default:
+            return false;
+    }
+}
