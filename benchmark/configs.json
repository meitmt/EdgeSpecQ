{
  "_doc": "Evaluation configurations: B0-B12 (precision matrix) and A0-A7 (ablation ladder, docs/report.md §2.2). target/draft are file tags: targets under models/target/LFM2.5-VL-3B-<target>.gguf; drafters F16 -> models/draft, <base> -> models/quant, <base>-V<size>k[-i32] -> models/e9. runtime names a set of shared libraries per platform (see runtimes). n_max null = platform default.",

  "platforms": {
    "jetson": {
      "home": "~/mt_test/liquid_ai",
      "llama_dir": "~/mt_test/liquid_ai/llama.cpp",
      "n_max": 6,
      "_server_args": "--cache-ram 0: llama-server's host prompt cache defaults to 8 GiB and fills the 8 GB board within one config (swap, OOM kills; 10-17)",
      "server_args": ["--cache-ram", "0"],
      "runtimes": {
        "master": ["libs/cuda_master", "libs/master", "libs/llama_base"],
        "fixed":  ["libs/cuda_fix", "libs/fix", "libs/llama_base"],
        "edge":   ["libs/cuda_fix", "libs/fix", "libs/llama_c4"]
      }
    },
    "jetson_25w": {
      "_doc": "same as jetson, measured in the factory-default 25W mode without jetson_clocks; own result dir",
      "home": "~/mt_test/liquid_ai",
      "llama_dir": "~/mt_test/liquid_ai/llama.cpp",
      "n_max": 6,
      "server_args": ["--cache-ram", "0"],
      "runtimes": {
        "master": ["libs/cuda_master", "libs/master", "libs/llama_base"],
        "fixed":  ["libs/cuda_fix", "libs/fix", "libs/llama_base"],
        "edge":   ["libs/cuda_fix", "libs/fix", "libs/llama_c4"]
      }
    },
    "phone": {
      "_doc": "OnePlus 13 (Snapdragon 8 Elite, 24 GB), CPU backend; llama-server runs on the device over adb (scripts/build_android.sh, binaries and models pushed to home). Only C3/C4 apply on CPU, so there are two runtimes. adb.serial null = adb's default device ($ANDROID_SERIAL or the only one connected); $ADB overrides adb.exe (e.g. the Windows adb.exe when running from WSL2).",
      "home": "/data/local/tmp/edgespecq",
      "log_home": "~/edgespecq",
      "adb": {"exe": "adb", "serial": null},
      "cooldown": {"max_battery_temp_c": 36, "timeout_s": 900, "pause_above_c": 45, "resume_below_c": 40},
      "port": 8097,
      "ngl": 0,
      "n_max": 8,
      "_runtimes": "fixed = master + the C3 scheduler fix (edge's libggml-base.so alone in fixed/lib, searched first)",
      "bin_dirs": {"master": "master/bin", "fixed": "master/bin", "edge": "edge/bin"},
      "runtimes": {"master": ["master/lib"], "fixed": ["fixed/lib", "master/lib"], "edge": ["edge/lib"]}
    },
    "phone_htp": {
      "_doc": "OnePlus 13, Hexagon NPU (HTP v79) for target and drafter (scripts/build_android_htp.sh). require_device makes run_eval refuse to measure when the target weights are not on HTP0 (silent CPU fallback).",
      "home": "/data/local/tmp/edgespecq",
      "log_home": "~/edgespecq",
      "adb": {"exe": "adb", "serial": null},
      "cooldown": {"max_battery_temp_c": 36, "timeout_s": 900, "pause_above_c": 45, "resume_below_c": 40},
      "port": 8097,
      "ngl": 99,
      "n_max": 8,
      "server_args": ["--device", "HTP0", "--device-draft", "HTP0"],
      "env": {"ADSP_LIBRARY_PATH": "{libs}"},
      "require_device": "HTP0",
      "bin_dirs": {"edge": "htp-edge/bin", "master": "htp-master/bin"},
      "runtimes": {"edge": ["htp-edge/lib"], "master": ["htp-master/lib"]}
    },
    "rtx5070": {
      "home": "~/edgespecq",
      "llama_dir": "~/edgespecq/llama-edge",
      "n_max": 8,
      "runtimes": {
        "master": ["libs/5070/master"],
        "fixed":  ["libs/5070/fixed"],
        "edge":   ["libs/5070/edge"]
      }
    }
  },

  "sampling": {
    "greedy": {"temperature": 0},
    "_liquid": "LFM2.5-VL-3B model card, text generation: temperature 0.2, top_k 50, repetition_penalty 1.0",
    "liquid": {"temperature": 0.2, "top_k": 50, "repeat_penalty": 1.0},
    "t07":    {"temperature": 0.7, "top_p": 0.95}
  },

  "configs": {
    "B0":  {"target": "Q4_K_M", "draft": null,          "runtime": "edge"},
    "B1":  {"target": "Q4_K_M", "draft": "F16",         "runtime": "edge"},
    "B1m": {"target": "Q4_K_M", "draft": "F16",         "runtime": "master", "n_max": 8, "_doc": "official drafter as shipped"},
    "B2":  {"target": "Q4_K_M", "draft": "Q8_0",        "runtime": "edge"},
    "B3":  {"target": "Q4_K_M", "draft": "Q4_K_M",      "runtime": "edge"},
    "B4":  {"target": "Q8_0",   "draft": null,          "runtime": "edge"},
    "B5":  {"target": "Q8_0",   "draft": "F16",         "runtime": "edge"},
    "B6":  {"target": "Q8_0",   "draft": "Q8_0",        "runtime": "edge"},
    "B7":  {"target": "Q8_0",   "draft": "Q4_K_M",      "runtime": "edge"},
    "B8":  {"target": "Q4_0",   "draft": null,          "runtime": "edge"},
    "B9":  {"target": "Q4_0",   "draft": "F16",         "runtime": "edge"},
    "B10": {"target": "Q4_0",   "draft": "Q4_0",        "runtime": "edge"},
    "B11": {"target": "Q4_K_M", "draft": "P3-V32k-i32",     "runtime": "edge"},
    "B12": {"target": "Q4_K_M", "draft": "Q4_K_M-V16k-i32", "runtime": "edge"},
    "B11g": {"target": "Q4_K_M", "draft": "P3-V32k-i32", "runtime": "edge", "device_draft": "GPUOpenCL", "_doc": "phone: target on HTP0, drafter on the Adreno GPU"},
    "B11c": {"target": "Q4_K_M", "draft": "P3-V32k-i32", "runtime": "edge", "device_draft": "CPU", "_doc": "phone: target on HTP0, drafter on the CPU"},
    "R0":  {"target": "F16",    "draft": null,          "runtime": "edge"},
    "R1":  {"target": "F16",    "draft": "F16",         "runtime": "edge"},
    "R11": {"target": "F16",    "draft": "P3-V32k-i32", "runtime": "edge", "_doc": "S3: F16 target with the B11 drafter"},
    "B1n1": {"target": "Q4_K_M", "draft": "F16",        "runtime": "edge", "n_max": 1, "_doc": "S3 CPU control: n_max 1"},

    "A0":  {"target": "Q4_K_M", "draft": null,          "runtime": "master"},
    "A1":  {"target": "Q4_K_M", "draft": "F16",         "runtime": "master", "n_max": 8},
    "A2":  {"target": "Q4_K_M", "draft": "F16",         "runtime": "fixed",  "n_max": 8},
    "A3":  {"target": "Q4_K_M", "draft": "Q8_0",        "runtime": "fixed",  "n_max": 8},
    "A4":  {"target": "Q4_K_M", "draft": "P3",          "runtime": "fixed",  "n_max": 8},
    "A5":  {"target": "Q4_K_M", "draft": "P3",          "runtime": "fixed"},
    "A6":  {"target": "Q4_K_M", "draft": "P3-V32k",     "runtime": "fixed"},
    "A7":  {"target": "Q4_K_M", "draft": "P3-V32k-i32", "runtime": "edge"}
  }
}
